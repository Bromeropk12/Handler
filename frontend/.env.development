# Configuración de desarrollo local
# Este archivo NO se incluye en builds de producción (react-scripts lo ignora en NODE_ENV=production).
#
# REACT_APP_API_URL sobreescribe la baseURL de axios en src/services/api.js
# cuando corres: pnpm start (dev server en :3000, backend en :3001)
#
# Si cambias el puerto del backend, actualiza solo este archivo.
REACT_APP_API_URL=http://localhost:3001/api
