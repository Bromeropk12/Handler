PORT=3001
NODE_ENV=development

# PostgreSQL Local (Docker)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=handler_track_samples
DB_USER=handler_user
DB_PASSWORD=handler_password

# JWT
JWT_SECRET=handler_secret_key_ejemplo_cambiar

# Directorio de CoA
COA_DIRECTORY=C:\Handler\CoA