# =============================================================
# Handler TrackSamples Backend — Configuración de ejemplo
# Copiar este archivo a .env y completar los valores reales
# =============================================================

# Server Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
# (H4) Por seguridad, el default es 127.0.0.1 (solo esta máquina). Cambia a
# 0.0.0.0 SOLO si necesitas exponer la API a otros equipos de la LAN.
HOST=127.0.0.1

# ─────────────────────────────────────────────────────────────
# CORS — Lista explícita de orígenes permitidos (separados por coma)
# ─────────────────────────────────────────────────────────────
# IMPORTANTE: por seguridad NO se acepta ninguna IP privada por regex.
# Debes declarar aquí las IPs/dominios EXACTOS de las terminales
# que consumirán la API (frontend React o clientes HTTP).
#
# Ejemplo para 2 terminales LAN:
#   ALLOWED_ORIGINS=http://192.168.1.100:3000,http://192.168.1.101:3000
#
# Si dejas vacío, solo se permitirán los defaults (localhost/127.0.0.1:3000).
# En producción se mostrará un warning si no configuras este valor.
ALLOWED_ORIGINS=

# ─────────────────────────────────────────────────────────────
# Database — PostgreSQL Local (levantado con docker-compose)
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://handler_user:handler_password@localhost:5432/handler_track_samples

DB_HOST=localhost
DB_PORT=5432
DB_NAME=handler_track_samples
DB_USER=handler_user
DB_PASSWORD=handler_password

# ─────────────────────────────────────────────────────────────
# JWT — CAMBIAR en todo despliegue real
# ─────────────────────────────────────────────────────────────
JWT_SECRET=cambia-esto-por-una-cadena-aleatoria-larga-de-al-menos-64-caracteres
JWT_EXPIRES_IN=8h

# Logging
LOG_LEVEL=info

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# CoA Directory
COA_BASE_DIR=uploads/coa

# Security
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=5000
