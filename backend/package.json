{
  "name": "handler-track-samples-backend",
  "version": "1.0.0",
  "description": "Backend API para Handler TrackSamples - Gestión de muestras químicas",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "migrate": "node scripts/migrate.js",
    "build:exe": "pkg --config pkg.config.js --output build/backend.exe src/index.js",
    "build:tables": "pkg --config pkg.config.js --output build/create_tables.exe create_tables.js",
    "build:all": "pnpm run build:exe && pnpm run build:tables"
  },
  "keywords": [
    "handler",
    "track-samples",
    "chemicals",
    "warehouse",
    "api"
  ],
  "author": "Handler S.A.S.",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.16.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "form-data": "^4.0.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "pg": "^8.11.3",
    "qrcode": "^1.5.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "pkg": "5.8.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "pnpm": {
    "overrides": {
      "lru-cache": "^7.12.1"
    }
  }
}